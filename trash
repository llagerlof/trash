#!/bin/bash

# Trash 1.3.0
#
# A script that safely moves files and directories to a destination folder
# without overwriting existing items.
# Supports multiple files or directories as arguments.

# Function to add a suffix before the file extension
add_suffix_before_extension() {
    local filename=$1
    local suffix=$2
    extension="${filename##*.}"
    filename="${filename%.*}"
    if [ "$filename" = "$extension" ]; then
        # The file does not have an extension
        echo "${filename}-${suffix}"
    else
        # The file has an extension
        echo "${filename}-${suffix}.${extension}"
    fi
}

usage() {
    echo "Trash 1.3.0"
    echo "Usage: $0 <source>... [destination_directory]"
    echo "       $0 <source>... -d destination_directory"
    echo "       $0 -h|--help"
    echo "Moves files/directories to a destination without overwriting."
    echo "If destination is omitted, defaults to ~/.trash."
}

# Main script starts here
if [ "$#" -lt 1 ]; then
    usage
    exit 1
fi

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    exit 0
fi

# Parse arguments
specified_dest=""
sources=()
i=1

while [ $i -le $# ]; do
    arg="${!i}"
    if [ "$arg" = "-d" ]; then
        ((i++))
        if [ $i -le $# ]; then
            specified_dest="${!i}"
        else
            echo "Error: -d option requires a directory argument"
            exit 1
        fi
    else
        sources+=("$arg")
    fi
    ((i++))
done

if [ ${#sources[@]} -eq 0 ]; then
    echo "Error: No source files or directories specified"
    usage
    exit 1
fi

# Determine destination
if [ -n "$specified_dest" ]; then
    dest="$specified_dest"
else
    last_index=$((${#sources[@]} - 1))
    last_source="${sources[$last_index]}"
    if [ -d "$last_source" ]; then
        dest="$last_source"
        unset 'sources[$last_index]'
    else
        dest="${HOME}/.trash"
    fi
fi

if [ ${#sources[@]} -eq 0 ]; then
    echo "Error: No source files or directories specified"
    usage
    exit 1
fi

# Create or validate destination directory
if [ ! -d "$dest" ]; then
    if [ "$dest" = "${HOME}/.trash" ]; then
        mkdir -p "$dest" || { echo "Failed to create default trash directory at $dest"; exit 1; }
        echo "Created default trash directory at $dest"
    else
        echo "Error: Destination directory '$dest' does not exist"
        exit 1
    fi
fi

if [ ! -d "$dest" ]; then
    echo "Destination directory does not exist."
    exit 1
fi

success_count=0
failure_count=0

for src in "${sources[@]}"; do
    if [ ! -e "$src" ] && [ ! -L "$src" ]; then
        echo "Source does not exist: $src"
        ((failure_count++))
        continue
    fi

    if [ -L "$src" ]; then
        base=$(basename "$src")
        new_dest_path="$dest/$base"
        count=2
        while [ -e "$new_dest_path" ] || [ -L "$new_dest_path" ]; do
            new_base=$(add_suffix_before_extension "$base" "$count")
            new_dest_path="$dest/$new_base"
            ((count++))
        done
        if mv -- "$src" "$new_dest_path"; then
            echo "Moved to $new_dest_path"
            ((success_count++))
        else
            echo "Failed to move: $src"
            ((failure_count++))
        fi
        continue
    fi

    if [ -d "$src" ]; then
        dest_real=$(cd "$dest" && pwd -P)
        src_parent=$(cd "$(dirname "$src")" && pwd -P)
        src_real="$src_parent/$(basename "$src")"
        case "$dest_real" in
            "$src_real"|"$src_real"/*)
                echo "Refusing to move a directory into itself: $src"
                ((failure_count++))
                continue
                ;;
        esac
    fi

    if [ -f "$src" ]; then
        base=$(basename "$src")
        new_dest_path="$dest/$base"
        count=2
        while [ -e "$new_dest_path" ] || [ -L "$new_dest_path" ]; do
            new_base=$(add_suffix_before_extension "$base" "$count")
            new_dest_path="$dest/$new_base"
            ((count++))
        done
        if mv -- "$src" "$new_dest_path"; then
            echo "Moved to $new_dest_path"
            ((success_count++))
        else
            echo "Failed to move: $src"
            ((failure_count++))
        fi

    elif [ -d "$src" ]; then
        base=$(basename "$src")
        new_dest_path="$dest/$base"
        count=2
        while [ -e "$new_dest_path" ] || [ -L "$new_dest_path" ]; do
            new_dest_path="$dest/${base}-${count}"
            ((count++))
        done
        if mv -- "$src" "$new_dest_path"; then
            echo "Moved to $new_dest_path"
            ((success_count++))
        else
            echo "Failed to move: $src"
            ((failure_count++))
        fi

    else
        echo "The source is neither a file, directory, nor symlink: $src"
        ((failure_count++))
    fi
done

# Print summary
echo "-----------------------------------"
echo "Operation Summary:"
echo "  $success_count items moved successfully"
if [ $failure_count -gt 0 ]; then
    echo "  $failure_count items failed to move"
fi

if [ $failure_count -gt 0 ]; then
    exit 1
fi
